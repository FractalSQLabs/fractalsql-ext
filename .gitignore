# Build output
build/

# Build artifacts
*.o
*.a
*.so
*.dylib
*.duckdb_extension
fractalsql.duckdb_extension

# Tracked exceptions: the prebuilt libraries under include/ (including the per-platform
# include/<os>-<arch>/ directories) are committed. `**` is needed because `*` does not cross
# a directory separator.
!include/**/*.a
!include/**/*.so
!include/**/*.dylib
!include/**/*.lib
!include/**/*.dll
!include/VERSION
!include/REASONING_VERSION

# Distribution output
dist/

# Packaging temp files
*.zip

# DuckDB bundle extracted during configure
libduckdb/
*.duckdb

